{
  "name": "marten",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "test": "node --import tsx --test apps/api/test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "probe": "node --import tsx apps/api/src/probe.ts",
    "start": "node --import tsx apps/api/src/server.ts",
    "web:dev": "pnpm --filter @marten/web dev",
    "web:build": "pnpm --filter @marten/web build",
    "web:typecheck": "pnpm --filter @marten/web typecheck"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
