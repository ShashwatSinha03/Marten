PORT=3001
FRONTEND_ORIGIN=http://localhost:3000
# Server only: pooled Neon Postgres URL. Certificate verification is enforced.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Exact managed auth URL from Neon console, including /neondb/auth path.
NEON_AUTH_BASE_URL=https://YOUR_AUTH_HOST/neondb/auth
NEON_STORAGE_ENDPOINT=https://YOUR_STORAGE_HOST
NEON_STORAGE_REGION=us-east-2
NEON_STORAGE_BUCKET=marten-evidence
NEON_STORAGE_ACCESS_KEY_ID=YOUR_BUCKET_SCOPED_ACCESS_KEY
NEON_STORAGE_SECRET_ACCESS_KEY=YOUR_BUCKET_SCOPED_SECRET
GEMINI_MODEL=gemini-2.5-flash
MARTEN_STARTUP_PROBE=false
